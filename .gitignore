# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bun.lock

# testing
/coverage
/coverage-pricing

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!*.example

# reports
# reports/

# iteration sessions (keep .gitkeep, ignore session files)
prompt-bench/sessions/*.json
!prompt-bench/sessions/.gitkeep

notes.md
.eslintcache

docs/archive/*
# Prompt Bench Logs
prompt-bench/logs/*.log

# Component extraction dist
prompt-bench/ui/dist/
