{
  // Disable Biome
  "biome.enabled": false,

  // Enable ESLint
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // Use ESLint for formatting (optional - only if you want auto-format on save)
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Set default formatter to ESLint (optional)
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  }
}
